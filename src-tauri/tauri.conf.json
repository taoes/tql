{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TQL",
  "version": "0.1.0",
  "identifier": "com.taoes.tql",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Text Query Language",
        "maximized": true,
        "resizable": true,
        "minWidth": 1200,
        "minHeight": 800,
        "x": 0,
        "y": 0,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "visible": true,
        "fullscreen": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    }
  }
}